{
  "name": "@tendia/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de TendIA: identidad, consentimientos, solicitudes, conectores y orquestación del score.",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest --runInBand --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/seed.js",
    "mfa:reset": "node dist/scripts/reset-mfa.js",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.1.0",
    "@sentry/node": "11.9.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "otplib": "12.0.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.0"
  }
}
