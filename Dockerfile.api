# API de TendIA. Se construye desde la raíz del monorepo:
#   docker build -f Dockerfile.api .
# Vive en la raíz porque Vercel usa la carpeta del Dockerfile como contexto de build.
FROM node:22.23-alpine AS build
RUN npm i -g pnpm@9.15.0
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY services/api/package.json services/api/
RUN pnpm install --frozen-lockfile --filter @tendia/api...
COPY services/api services/api
RUN pnpm --filter @tendia/api build && pnpm --filter @tendia/api deploy --prod /out \
    && cp -r services/api/dist services/api/prisma /out/ \
    && cd /out && npx prisma@6.1.0 generate

FROM node:22.23-alpine
# La CLI de Prisma queda en la imagen para migrar al arrancar sin descargarla cada vez.
RUN apk add --no-cache openssl && npm i -g prisma@6.1.0
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /out .
USER node
EXPOSE 4000
# Aplica migraciones pendientes y arranca. En Vercel migra por DIRECT_URL (session pooler): el
# pooler de transacciones de DATABASE_URL no sirve para migraciones. En local no hay DIRECT_URL.
CMD ["sh", "-c", "DATABASE_URL=\"${DIRECT_URL:-$DATABASE_URL}\" prisma migrate deploy && exec node dist/main.js"]
