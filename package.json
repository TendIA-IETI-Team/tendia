{
  "name": "tendia",
  "private": true,
  "description": "TendIA: crédito basado en tu negocio, no en tu pasado bancario.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31",
      "@nestjs/swagger>js-yaml": "5.5.0",
      "@nestjs/platform-express>multer": "2.5.0",
      "postcss-selector-parser": "7.1.6"
    }
  }
}
