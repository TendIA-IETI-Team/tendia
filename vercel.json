{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portal": {
      "root": "apps/portal",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --filter @tendia/portal...",
      "buildCommand": "pnpm build"
    },
    "app": {
      "root": "apps/mobile",
      "installCommand": "npm ci --no-audit --no-fund",
      "buildCommand": "EXPO_BASE_URL=/app EXPO_PUBLIC_API_URL=/api npx expo export -p web --output-dir dist-vercel/app",
      "outputDirectory": "dist-vercel",
      "rewrites": [
        {
          "source": "/app",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/(.*)",
          "destination": "/app/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.api",
      "bindings": [
        {
          "type": "service",
          "service": "scoring",
          "format": "url",
          "env": "SCORING_URL"
        }
      ],
      "rewrites": [
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ]
    },
    "scoring": {
      "root": "services/scoring",
      "framework": "fastapi",
      "entrypoint": "tendia_scoring.app:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/app",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portal"
      }
    }
  ]
}
