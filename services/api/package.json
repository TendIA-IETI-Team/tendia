{
  "name": "@tendia/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de TendIA: identidad, consentimientos, solicitudes, conectores y orquestación del score.",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node dist/seed.js",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.0",
    "@nestjs/throttler": "6.3.0",
    "@prisma/client": "6.1.0",
    "@sentry/node": "8.47.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.0.0",
    "nestjs-pino": "4.1.0",
    "otplib": "12.0.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "prisma": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
